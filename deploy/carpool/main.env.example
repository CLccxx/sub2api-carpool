# Copy to a private main.env and fill every blank before validation.
# Use the customized image's immutable ID after docker load, not upstream latest.
CARPOOL_IMAGE=
PUBLIC_URL=
BIND_HOST=127.0.0.1
SERVER_PORT=8080
# Comma-separated actual proxy peer IP/CIDRs. Empty explicitly trusts no proxy.
SERVER_TRUSTED_PROXIES=
POSTGRES_USER=sub2api
POSTGRES_DB=sub2api
POSTGRES_PASSWORD=
REDIS_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Generate each independently. JWT: openssl rand -hex 32
JWT_SECRET=
# TOTP: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=
# Carpool root: openssl rand -base64 32. Back it up separately from the database.
CARPOOL_CONTROL_ENCRYPTION_KEY=
# Comma-separated HTTPS origins; do not use private/loopback destinations.
CARPOOL_CONTROL_ALLOWED_ORIGINS=
