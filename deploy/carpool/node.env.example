# Copy to a private node.env on this car's own server. Do not reuse A's secrets.
CARPOOL_IMAGE=
PUBLIC_URL=
BIND_HOST=127.0.0.1
SERVER_PORT=8080
# Comma-separated actual proxy peer IP/CIDRs. Empty explicitly trusts no proxy.
SERVER_TRUSTED_PROXIES=
POSTGRES_USER=sub2api
POSTGRES_DB=sub2api
POSTGRES_PASSWORD=
REDIS_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
# These UUIDs come from A's car/node configuration, not newly generated values.
CARPOOL_NODE_MAIN_INSTANCE_ID=
CARPOOL_NODE_NODE_ID=
CARPOOL_NODE_CAR_ID=
